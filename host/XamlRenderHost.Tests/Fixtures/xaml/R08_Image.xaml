<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="200" Height="120" Background="White">
  <Grid.Resources>
    <DrawingImage x:Key="Art">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="Teal"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,100,60"/></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing Brush="Yellow"><GeometryDrawing.Geometry><EllipseGeometry Center="50,30" RadiusX="22" RadiusY="22"/></GeometryDrawing.Geometry></GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
  </Grid.Resources>
  <Image Source="{StaticResource Art}" Width="160" Height="96" Stretch="Uniform"/>
</Grid>
