<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="240" Height="100" Background="White">
  <Grid.Resources>
    <ControlTemplate x:Key="PillButton" TargetType="Button">
      <Border Background="{TemplateBinding Background}" CornerRadius="18" Padding="16,6" BorderBrush="DarkSlateBlue" BorderThickness="2">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
    </ControlTemplate>
  </Grid.Resources>
  <Button Content="Pill" Template="{StaticResource PillButton}" Background="Lavender" Width="130" Height="40" FontFamily="Segoe UI" FontSize="16"/>
</Grid>
