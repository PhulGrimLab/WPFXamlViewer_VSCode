<Configuration>
  <!--
    Windows Sandbox 설정: Visual Studio / .NET / VS Code가 없는 깨끗한 Windows에서 .vsix를 시험한다(doc/02 M6.4, doc/05).
    사용 전: 1) Windows 기능 "Windows 샌드박스" 켜기(관리자, 재부팅) 2) `tools\ci\ci.ps1 -IncludePackage` 또는 `npm run package`로 .vsix 생성
            3) 아래 HostFolder를 이 저장소의 실제 경로로 바꾸고 이 파일을 더블 클릭.
    작성만 했고 실행해 보지 못했다(개발 PC에서 샌드박스 기능이 꺼져 있다).
  -->
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\Works_PhulgrimLab\WPFXamlViewer_VSCode</HostFolder>
      <SandboxFolder>C:\repo</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <Networking>Enable</Networking>
  <LogonCommand>
    <Command>powershell.exe -NoProfile -ExecutionPolicy Bypass -File C:\repo\tools\verify\sandbox_bootstrap.ps1</Command>
  </LogonCommand>
</Configuration>
