{
  "name": "wpf-xaml-live-preview",
  "displayName": "WPF XAML Live Preview",
  "description": "%extension.description%",
  "version": "0.1.5",
  "publisher": "phulgrimlab",
  "license": "GPL-3.0-only",
  "preview": true,
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e1b4b",
    "theme": "dark"
  },
  "homepage": "https://github.com/PhulGrimLab/WPFXamlViewer_VSCode#readme",
  "bugs": {
    "url": "https://github.com/PhulGrimLab/WPFXamlViewer_VSCode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PhulGrimLab/WPFXamlViewer_VSCode.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "os": [
    "win32"
  ],
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "wpf",
    "xaml",
    "preview",
    "dotnet",
    "designer",
    "live preview"
  ],
  "activationEvents": [
    "onLanguage:xml",
    "onLanguage:xaml",
    "onCommand:wpfXamlViewer.openPreview"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "wpfXamlViewer.openPreview",
        "title": "%command.openPreview.title%"
      },
      {
        "command": "wpfXamlViewer.buildProject",
        "title": "%command.buildProject.title%"
      },
      {
        "command": "wpfXamlViewer.rebuildProject",
        "title": "%command.rebuildProject.title%"
      },
      {
        "command": "wpfXamlViewer.cleanProject",
        "title": "%command.cleanProject.title%"
      },
      {
        "command": "wpfXamlViewer.restoreProject",
        "title": "%command.restoreProject.title%"
      },
      {
        "command": "wpfXamlViewer.buildProjectDebug",
        "title": "%command.buildProjectDebug.title%"
      },
      {
        "command": "wpfXamlViewer.buildProjectRelease",
        "title": "%command.buildProjectRelease.title%"
      },
      {
        "command": "wpfXamlViewer.rebuildProjectDebug",
        "title": "%command.rebuildProjectDebug.title%"
      },
      {
        "command": "wpfXamlViewer.rebuildProjectRelease",
        "title": "%command.rebuildProjectRelease.title%"
      },
      {
        "command": "wpfXamlViewer.cleanProjectDebug",
        "title": "%command.cleanProjectDebug.title%"
      },
      {
        "command": "wpfXamlViewer.cleanProjectRelease",
        "title": "%command.cleanProjectRelease.title%"
      },
      {
        "command": "wpfXamlViewer.buildXamlProject",
        "title": "%command.buildXamlProject.title%"
      },
      {
        "command": "wpfXamlViewer.switchLanguage",
        "title": "%command.switchLanguage.title%"
      },
      {
        "command": "wpfXamlViewer.resetProjectConsent",
        "title": "%command.resetProjectConsent.title%"
      }
    ],
    "configuration": {
      "title": "WPF XAML Live Preview",
      "properties": {
        "wpfXamlViewer.autoOpenPreview": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoOpenPreview.description%"
        },
        "wpfXamlViewer.autoBuildOnPreview": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoBuildOnPreview.description%"
        },
        "wpfXamlViewer.buildConfiguration": {
          "type": "string",
          "enum": [
            "Debug",
            "Release"
          ],
          "default": "Debug",
          "description": "%config.buildConfiguration.description%"
        },
        "wpfXamlViewer.buildTargetFramework": {
          "type": "string",
          "default": "",
          "description": "%config.buildTargetFramework.description%"
        },
        "wpfXamlViewer.buildExtraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.buildExtraArgs.description%"
        },
        "wpfXamlViewer.language": {
          "type": "string",
          "enum": [
            "auto",
            "ko",
            "en"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%config.language.enum.auto%",
            "%config.language.enum.ko%",
            "%config.language.enum.en%"
          ],
          "description": "%config.language.description%"
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "wpfXamlViewer.buildProject",
          "when": "resourceExtname == .csproj && isWorkspaceTrusted || (resourceExtname == .sln || resourceExtname == .slnx) && isWorkspaceTrusted || resourceExtname == .slnf && isWorkspaceTrusted",
          "group": "7_wpfXamlBuild@1"
        },
        {
          "command": "wpfXamlViewer.rebuildProject",
          "when": "resourceExtname == .csproj && isWorkspaceTrusted",
          "group": "7_wpfXamlBuild@2"
        },
        {
          "command": "wpfXamlViewer.cleanProject",
          "when": "resourceExtname == .csproj && isWorkspaceTrusted || (resourceExtname == .sln || resourceExtname == .slnx) && isWorkspaceTrusted || resourceExtname == .slnf && isWorkspaceTrusted",
          "group": "7_wpfXamlBuild@3"
        },
        {
          "command": "wpfXamlViewer.restoreProject",
          "when": "resourceExtname == .csproj && isWorkspaceTrusted",
          "group": "7_wpfXamlBuild@4"
        },
        {
          "submenu": "wpfXamlViewer.configMenu",
          "when": "resourceExtname == .csproj && isWorkspaceTrusted || (resourceExtname == .sln || resourceExtname == .slnx) && isWorkspaceTrusted || resourceExtname == .slnf && isWorkspaceTrusted",
          "group": "7_wpfXamlBuild@5"
        }
      ],
      "editor/context": [
        {
          "command": "wpfXamlViewer.buildXamlProject",
          "when": "resourceExtname == .xaml && isWorkspaceTrusted",
          "group": "7_wpfXamlBuild@1"
        }
      ],
      "commandPalette": [
        {
          "command": "wpfXamlViewer.buildProject",
          "when": "false"
        },
        {
          "command": "wpfXamlViewer.rebuildProject",
          "when": "false"
        },
        {
          "command": "wpfXamlViewer.cleanProject",
          "when": "false"
        },
        {
          "command": "wpfXamlViewer.restoreProject",
          "when": "false"
        },
        {
          "command": "wpfXamlViewer.buildProjectDebug",
          "when": "false"
        },
        {
          "command": "wpfXamlViewer.buildProjectRelease",
          "when": "false"
        },
        {
          "command": "wpfXamlViewer.rebuildProjectDebug",
          "when": "false"
        },
        {
          "command": "wpfXamlViewer.rebuildProjectRelease",
          "when": "false"
        },
        {
          "command": "wpfXamlViewer.cleanProjectDebug",
          "when": "false"
        },
        {
          "command": "wpfXamlViewer.cleanProjectRelease",
          "when": "false"
        },
        {
          "command": "wpfXamlViewer.buildXamlProject",
          "when": "resourceExtname == .xaml && isWorkspaceTrusted"
        }
      ],
      "wpfXamlViewer.configMenu": [
        {
          "command": "wpfXamlViewer.buildProjectDebug",
          "when": "resourceExtname == .csproj && isWorkspaceTrusted || (resourceExtname == .sln || resourceExtname == .slnx) && isWorkspaceTrusted || resourceExtname == .slnf && isWorkspaceTrusted",
          "group": "1_build@1"
        },
        {
          "command": "wpfXamlViewer.buildProjectRelease",
          "when": "resourceExtname == .csproj && isWorkspaceTrusted || (resourceExtname == .sln || resourceExtname == .slnx) && isWorkspaceTrusted || resourceExtname == .slnf && isWorkspaceTrusted",
          "group": "1_build@2"
        },
        {
          "command": "wpfXamlViewer.rebuildProjectDebug",
          "when": "resourceExtname == .csproj && isWorkspaceTrusted",
          "group": "2_rebuild@1"
        },
        {
          "command": "wpfXamlViewer.rebuildProjectRelease",
          "when": "resourceExtname == .csproj && isWorkspaceTrusted",
          "group": "2_rebuild@2"
        },
        {
          "command": "wpfXamlViewer.cleanProjectDebug",
          "when": "resourceExtname == .csproj && isWorkspaceTrusted || (resourceExtname == .sln || resourceExtname == .slnx) && isWorkspaceTrusted || resourceExtname == .slnf && isWorkspaceTrusted",
          "group": "3_clean@1"
        },
        {
          "command": "wpfXamlViewer.cleanProjectRelease",
          "when": "resourceExtname == .csproj && isWorkspaceTrusted || (resourceExtname == .sln || resourceExtname == .slnx) && isWorkspaceTrusted || resourceExtname == .slnf && isWorkspaceTrusted",
          "group": "3_clean@2"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "wpfXamlViewer.dotnet",
        "required": [
          "action",
          "target"
        ],
        "properties": {
          "action": {
            "type": "string",
            "description": "build | rebuild | clean | restore"
          },
          "target": {
            "type": "string",
            "description": "%task.target.description%"
          }
        }
      }
    ],
    "submenus": [
      {
        "id": "wpfXamlViewer.configMenu",
        "label": "%submenu.configMenu.label%"
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "신뢰되지 않은 폴더에서는 프로젝트 DLL을 불러오지 않고 사용자 정의 컨트롤을 자리표시자로 표시합니다.",
      "restrictedConfigurations": [
        "wpfXamlViewer.buildExtraArgs"
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "pretest": "npm run compile",
    "test": "mocha \"out/test/unit/**/*.test.js\"",
    "test:realhost": "npm run compile && mocha --timeout 30000 \"out/test/realhost/**/*.test.js\"",
    "test:integration": "npm run compile && node out/test/integration/runTest.js",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File ../tools/package/build_vsix.ps1",
    "test:smoke": "npm run compile && node out/test/smoke/runSmoke.js",
    "compile:build": "tsc -p ./tsconfig.build.json"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "mocha": "^11.0.0",
    "typescript": "^5.6.0"
  }
}
